{
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/retention",  "schedule": "0 3 * * *" },
    { "path": "/api/cron/benchmark",  "schedule": "0 4 * * *" },
    { "path": "/api/cron/policy-causes", "schedule": "0 3 * * *" },
    { "path": "/api/cron/drift",      "schedule": "0 5 * * *" },
    { "path": "/api/cron/chargeback", "schedule": "0 6 * * *" },
    { "path": "/api/cron/plg",               "schedule": "0 9 * * *" },
    { "path": "/api/cron/newsletter",        "schedule": "0 9 * * 1" },
    { "path": "/api/cron/billing-reconcile", "schedule": "0 2 * * *" },
    { "path": "/api/cron/signal-monitor",    "schedule": "0 7 * * *" },
    { "path": "/api/cron/corpus-miner",      "schedule": "0 8 * * *" },
    { "path": "/api/cron/social-dispatch",   "schedule": "0 10 * * *" },
    { "path": "/api/cron/siem",             "schedule": "0 * * * *" },
    { "path": "/api/cron/seal-checkpoints", "schedule": "20 * * * *" },
    { "path": "/api/cron/scope-audit",      "schedule": "40 * * * *" },
    { "path": "/api/cron/adversarial-guard", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/error-digest",     "schedule": "*/15 * * * *" },
    { "path": "/api/cron/governance-findings", "schedule": "30 * * * *" },
    { "path": "/api/cron/uptime",           "schedule": "*/5 * * * *" }
  ]
}
