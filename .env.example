# ============================================================================
#  SELF-HOST  (git clone + docker compose up)
# ============================================================================
#  The database is bundled — you do NOT need Supabase or any external service.
#  Everything below is OPTIONAL. Observing agents, time-travel replay, and the
#  signed audit export all work with NONE of these set.
#
#  ── Connect your LLMs ──────────────────────────────────────────────────────
#  Your agents already call your own LLMs; Runback's SDK just records those
#  calls (your provider keys live in your agent, not here). You only set a key
#  below if you want Runback to RE-EXECUTE a step itself — i.e. live "replay
#  from step N" or eval LLM-judges. Set the providers you use; leave the rest
#  blank. Supported today: OpenAI, Anthropic, Groq.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
#
#  ── Demo mode (zero-cost, no provider calls) ───────────────────────────────
#  RUNBACK_DEMO_MODE=1 turns the WHOLE deployment into a demo: replay, evals, and
#  whole-run replay return deterministic simulated results and never call a model
#  (this is how the hosted marketing site runs). Leave blank for the real product.
RUNBACK_DEMO_MODE=
#  RUNBACK_DEMO_EMAILS: comma-separated accounts that are ALWAYS fully simulated
#  (and auto-seeded with sample data on login), even on a real keyed deployment —
#  perfect for a sales/demo login. Defaults to demo@runback.dev if unset.
RUNBACK_DEMO_EMAILS=demo@runback.dev
#
# ── Security: REQUIRED for production ──────────────────────────────────────
#  The vars marked REQUIRED below are enforced — docker compose up hard-fails
#  without them. Ones marked OPTIONAL are safe to leave blank.
#
#  1. HMAC key for tamper-evident audit records
#
#     Also seals inter-agent trust-chain attestations (multi-agent delegation
#     proofs, Pro plan) — both go through the same signing module
#     (web/lib/signing.ts) so there's one key story, not two. Everything below
#     about rotation and the Ed25519 upgrade applies equally to both.
#     Generate: openssl rand -hex 32
AUDIT_SIGNING_KEY=

#  1a. ROTATING the key above? Put the OUTGOING value here first.
#
#      Ledger checkpoint signatures are stored in the database and verified by
#      recomputing them. Rotating without this makes every checkpoint sealed
#      under the old key fail — and since verification is fail-closed, a
#      perfectly intact ledger reports as TAMPERED. The same applies to any
#      audit record a customer has already downloaded and filed as evidence,
#      and to any stored trust-chain attestation.
#
#      Signing always uses AUDIT_SIGNING_KEY; verification accepts both. Clear
#      this once every checkpoint signed under the old key has been re-sealed.
AUDIT_SIGNING_KEY_PREVIOUS=

#  1b. OPTIONAL but strongly recommended: Ed25519 audit signing key.
#
#      AUDIT_SIGNING_KEY (above) is symmetric — an auditor can only check the
#      signature if you hand them the secret, which defeats the point. With an
#      Ed25519 keypair set, records (and trust-chain attestations) are signed
#      asymmetrically and ANYONE can verify them offline against your public
#      key, with no secret shared:
#
#          npx @runback/verify audit.json
#
#      Records fall back to HMAC when this is unset. Generate with:
#          openssl genpkey -algorithm ed25519 -out audit_ed25519.pem
#          # then paste the file contents (including the BEGIN/END lines)
#
#      The matching public key is derived automatically and served at
#      /.well-known/runback-audit-key.pem so verifiers can pin against it.
#      Set AUDIT_ED25519_PUBLIC_KEY only if you want to publish a key whose
#      private half lives elsewhere (e.g. in an HSM or signing service).
AUDIT_ED25519_PRIVATE_KEY=
AUDIT_ED25519_PUBLIC_KEY=

#      ROTATING the Ed25519 pair above? Same story as AUDIT_SIGNING_KEY_PREVIOUS
#      (1a) — put the OUTGOING keys here first, or every checkpoint sealed
#      under the old key reports as TAMPERED. Clear once every checkpoint
#      signed under the old key has been re-sealed.
AUDIT_ED25519_PRIVATE_KEY_PREVIOUS=
AUDIT_ED25519_PUBLIC_KEY_PREVIOUS=

#  2. Postgres superuser password (do NOT leave blank for any non-dev deployment)
POSTGRES_PASSWORD=

#  3. PostgREST authenticator role password (separate from POSTGRES_PASSWORD so
#     the two can differ and POSTGRES_PASSWORD stays unknown to PostgREST).
#     Generate: openssl rand -hex 32
AUTHENTICATOR_PASSWORD=

#  4. JWT secret for PostgREST token signing
#     Generate: openssl rand -hex 32
#     Also activates lib/supabase/tenant.ts's database-enforced tenant
#     isolation (RLS via the `tenant` role in sql/create_tenant_role.sql) — a
#     defense-in-depth layer under the app's own org_id filtering.
#     docker-compose.yml passes this same value through as SUPABASE_JWT_SECRET
#     automatically (PostgREST validates every token, tenant-scoped or not,
#     against this one secret), so there is nothing extra to generate here.
#     Leaving JWT_SECRET unset (impossible — docker-compose.yml hard-fails
#     without it) is the only way this layer stays off.
JWT_SECRET=

#  5. Cron authentication — set a strong secret; pass it as Bearer on cron calls.
#     Generate: openssl rand -hex 32
CRON_SECRET=

#  6 & 7. PostgREST anon + service-role JWTs — signed with JWT_SECRET above.
#     MUST be regenerated whenever JWT_SECRET changes.
#     Generate (after setting JWT_SECRET above):
#   JWT_SECRET=<your secret> \
#   node -e 'const c=require("node:crypto"),b=o=>Buffer.from(JSON.stringify(o)).toString("base64url"),s=process.env.JWT_SECRET,h=b({alg:"HS256",typ:"JWT"});["anon","service_role"].forEach(r=>{const p=b({role:r,iss:"runback-selfhost",iat:(Date.now()/1e3|0),exp:(Date.now()/1e3|0)+3153600000});console.log(r+": "+h+"."+p+"."+c.createHmac("sha256",s).update(h+"."+p).digest("base64url"))})'
#
#     SUPABASE_ANON_KEY is OPTIONAL — nothing reads it. PostgREST verifies tokens
#     with JWT_SECRET and serves unauthenticated requests as PGRST_DB_ANON_ROLE;
#     the app only ever uses the service-role key. It was a hard requirement in
#     docker-compose.yml, so every self-hoster minted a JWT nothing consumed.
#     Only SUPABASE_SERVICE_ROLE_KEY below is actually needed.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

#  8. BYOK model key encryption secret — MUST be distinct from AUDIT_SIGNING_KEY.
#     Rotating the audit key must not invalidate customer BYOK model keys.
#     Generate: openssl rand -hex 32
MODEL_KEY_SECRET=

#  9. SSO client-secret encryption key — required if Enterprise SSO (OIDC) is enabled.
#     Encrypts the per-org IdP client secret at rest (AES-256-GCM). Distinct from
#     AUDIT_SIGNING_KEY and MODEL_KEY_SECRET so each key can be rotated independently.
#     Generate: openssl rand -hex 32
SSO_SECRET_KEY=

# 10. Newsletter/PLG unsubscribe HMAC key — OPTIONAL. Signs unsubscribe links so
#     they cannot be forged. Falls back to AUDIT_SIGNING_KEY when unset; set it
#     to give unsubscribe links their own rotation independent of the audit key.
#     Generate: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# 10b. SIEM collector token encryption key — required only if you forward the
#      admin audit log to Splunk/Sentinel. Encrypts the collector token at rest
#      (AES-256-GCM). Separate from the other secrets so rotating one never
#      invalidates the rest. Generate: openssl rand -hex 32
SIEM_SECRET_KEY=

# 10c. Workflow credential encryption key — required only if you raise findings
#      in ServiceNow, Jira or PagerDuty. Encrypts that credential at rest
#      (AES-256-GCM), separate from the others so each rotates independently.
#      Generate: openssl rand -hex 32
WORKFLOW_SECRET_KEY=

# 11. App public URL — used for magic-link email href, webhook callbacks, audit links.
#     Must be the exact URL users will open in their browser (no trailing slash).
#     Example: http://localhost:3000   (dev) or https://ai.yourcompany.com (prod)
NEXT_PUBLIC_APP_URL=

# 12. Resend API key — OPTIONAL. Without it the stack runs fine, you just get no
#     magic-link or alert email (lib/email.ts logs and no-ops). Set it when you
#     want real sign-in emails; until then use RUNBACK_DEMO_MODE=1 to sign in.
#     Create a free account at resend.com; use your domain or theirs for testing.
RESEND_API_KEY=
#  Where operator lead/notification emails are sent from and to — used by the
#  contact form, demo booking, and newsletter cron. OPTIONAL; needs RESEND_API_KEY
#  above. Applies to any deployment (self-host included), not hosted-only.
#  LEAD_NOTIFY_TO is PRIVATE — an inbox only you read. It is never shown to a
#  customer; see SUPPORT_EMAIL below for the address that is.
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
#  PUBLIC. The "questions? write us at ___" address printed inside outbound
#  customer email (welcome email, trial nudges, lifecycle emails). Defaults to
#  hello@runback.dev if unset. Keep distinct from LEAD_NOTIFY_TO above —
#  that one is commonly a personal inbox during early operation, and email
#  copy used to fall back to it directly, shipping the operator's personal
#  address to every subscriber.
SUPPORT_EMAIL=

#  ── Optional integrations (self-host) ──────────────────────────────────────
#  Enterprise license token. Leave empty for the free Community edition.
RUNBACK_LICENSE=
#  SSRF guard. Runback blocks outbound targets on private/RFC1918 addresses
#  on the hosted service (SSO issuers, alert webhooks, SIEM collectors) — real
#  protection there, since a tenant's target is on OUR network. Self-hosted,
#  this is ALLOWED BY DEFAULT (nothing to set) — RUNBACK_SELF_HOSTED=1 alone
#  opens it, because inside your own VPC the identity provider and log
#  collector ARE on a private address, and there's no other tenant's network
#  left to protect. Set this to "false" only if you want the stricter,
#  hosted-style behavior anyway. Always ignored on the hosted service.
RUNBACK_ALLOW_PRIVATE_TARGETS=
#  Internal RFC 3161 timestamp authority — set this for a genuinely air-gapped
#  deployment. Unset, sealing a ledger checkpoint requests a timestamp from two
#  public authorities (freetsa.org, timestamp.digicert.com) over the open
#  internet — only the checkpoint's hash and your request's source IP reach
#  them, never run content, but a truly air-gapped network can't reach them at
#  all. Comma-separated if you run more than one. Checkpoints still seal and
#  verify locally with no witness configured; you only lose third-party-
#  verifiable timestamping. See docs/WITNESSING.md.
RUNBACK_TSA_URLS=
#  Self-serve billing — Lemon Squeezy (merchant of record; handles tax +
#  invoicing). Applies to ANY deployment, self-host included, if you want the
#  in-app upgrade flow to take payment instead of just linking to /contact.
#  Most self-hosters skip this and use RUNBACK_LICENSE for Enterprise features
#  instead — leave unset and the upgrade CTA falls back to "talk to us".
#  Set a variant only for the tiers you're ready to sell — a plan missing its
#  variant id falls back to "talk to us" instead of rendering a checkout
#  button that would fail.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_SCALE=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_WEBHOOK_SECRET=
#  Operator alerts — where NEW production faults are sent. Email is the default
#  (needs RESEND_API_KEY, which magic-link sign-in already uses); the webhook is
#  there if you would rather it went to a chat channel. With neither set, errors
#  are still recorded and queryable — only the push is off, so you would not
#  hear about a fault before a customer reports it.
OPS_ALERT_EMAIL=
OPS_ALERT_WEBHOOK=
#  Alert delivery to Slack — optional, only if you use webhook alert rules.
SLACK_PLG_WEBHOOK=
SLACK_WEBHOOK_URL=
#  Social scheduling for the newsletter cron — optional.
BUFFER_ACCESS_TOKEN=
#  If this Buffer account/org has channels for more than one brand, scope
#  dispatch to just this product's channel(s): comma-separated Buffer
#  channel ids or channel names, case-insensitive. Leaving this unset posts
#  to EVERY connected channel on every run — set it before enabling the
#  social-dispatch cron.
BUFFER_CHANNEL_ALLOWLIST=

# ============================================================================
#  SDK EXAMPLES  (examples/ only — not needed to run the platform)
# ============================================================================
RUNBACK_INGEST_URL=http://localhost:3000
RUNBACK_API_KEY=REPLACE_THIS_WITH_A_REAL_KEY_FROM_THE_DASHBOARD

# ============================================================================
#  HOSTED-SITE OPERATOR ONLY  (running runback.dev yourself — not for self-host)
# ============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# RESEND_API_KEY=re_REPLACE_ME
# NEXT_PUBLIC_APP_URL=https://runback.dev
